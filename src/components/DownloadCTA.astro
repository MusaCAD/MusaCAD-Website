---
/**
 * DOWNLOAD CTA — the primary download button plus a small "other downloads"
 * line, both driven by the *live* latest GitHub release.
 *
 * Rendering happens twice, on purpose:
 *
 *  1. At build time (here) we emit a platform-neutral button pointing at the
 *     releases page, the full asset list in the small line, and the release
 *     JSON in an inline `application/json` block. That is what no-JS visitors
 *     and crawlers get, and it is always correct — just not personalized.
 *  2. In the browser, `scripts/github-live.ts` reads that JSON, detects the
 *     visitor's OS and rewrites the button to the matching artifact (Windows →
 *     `.exe`, Linux → AppImage), demoting the rest to the small line. It then
 *     re-fetches from the API so a visit after a new release shows the new
 *     version without the site being rebuilt.
 *
 * The catalog spans releases: when the newest release skips a platform, that
 * platform's button points at the newest release that does have a build for it,
 * and the version chip names *that* release rather than the newest one.
 *
 * Both passes share the classification rules in `data/site.ts`, so the two
 * renderings can't drift.
 *
 * DOM contract used by the client script:
 *   [data-download]       root (carries the embedded release JSON)
 *   [data-dl-primary]     the anchor itself
 *   [data-dl-icon="<os>"] one icon per OS; all but the active one are hidden
 *   [data-dl-label]       button text
 *   [data-dl-tag]         version chip — the release this button hands you
 *   [data-dl-alt]         the small mono line, rebuilt wholesale
 *   [data-flatpak]        the Flathub panel — Linux visitors only once JS knows
 *                         the platform; no-JS visitors always see it
 */
import { getSnapshot } from '../data/github';
import { isFlathubVerified } from '../data/flathub';
import {
  FLATHUB_SETUP_URL,
  FLATHUB_URL,
  FLATPAK_STEPS,
  RELEASES_URL,
  assetLabel,
  assetTitle,
  isBehindLatest,
} from '../data/site';

interface Props {
  /** Classes for the primary button (callers own its size). */
  buttonClass?: string;
  /** Classes for the root wrapper. */
  class?: string;
  /** Render the Flathub install panel (shown to Linux visitors). */
  flatpak?: boolean;
  /** Anything else (e.g. `data-reveal`) lands on the root wrapper. */
  [key: string]: unknown;
}

const {
  buttonClass = 'px-5 py-3 text-[0.97rem]',
  class: rootClass = '',
  flatpak = true,
  ...rest
} = Astro.props;

const { catalog } = await getSnapshot();
const verified = flatpak && (await isFlathubVerified());

// `</script>` can't appear in a GitHub asset name, but escaping `<` keeps the
// inline JSON block valid no matter what lands in a future release.
const catalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');
---

<div data-download class={`flex flex-col gap-3 ${rootClass}`} {...rest}>
  <div class="flex flex-wrap items-center gap-3">
    <a
      data-dl-primary
      href={RELEASES_URL}
      target="_blank"
      rel="noopener"
      class={`btn btn-accent ${buttonClass}`}
    >
      <!-- One icon per platform; the client script unhides the matching one. -->
      <span
        class="relative inline-flex h-[18px] w-[18px] shrink-0 items-center justify-center"
        aria-hidden="true"
      >
        <svg
          data-dl-icon="other"
          viewBox="0 0 24 24"
          class="h-[18px] w-[18px]"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 21h14"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          data-dl-icon="windows"
          viewBox="0 0 24 24"
          class="hidden h-[17px] w-[17px]"
          fill="currentColor"
        >
          <path
            d="M3 5.5 11 4.3v7.2H3V5.5Zm0 13L11 19.7v-7.1H3v5.9Zm9-14.4L21 3v8.5h-9V4.1Zm0 8.5h9V21l-9-1.1v-7.3Z"
          ></path>
        </svg>
        <svg
          data-dl-icon="linux"
          viewBox="0 0 24 24"
          class="hidden h-[19px] w-[19px]"
          fill="currentColor"
        >
          <path
            d="M12 2c-2.2 0-3.5 1.9-3.5 4.2 0 1.5.5 2.4.5 3.6 0 1-.8 1.8-1.6 3-1 1.4-2 2.8-2 4.7 0 .8.3 1.4.8 1.9-.2.5-.3 1-.1 1.4.4.7 1.4.8 2.4.8.7 0 1.3-.1 1.9-.1.6 0 1.2.1 1.9.1 1 0 2-.1 2.4-.8.2-.4.1-.9-.1-1.4.5-.5.8-1.1.8-1.9 0-1.9-1-3.3-2-4.7-.8-1.2-1.6-2-1.6-3 0-1.2.5-2.1.5-3.6C15.5 3.9 14.2 2 12 2Zm-1.3 4.1c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9Zm2.6 0c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9Z"
          ></path>
        </svg>
        <svg
          data-dl-icon="macos"
          viewBox="0 0 24 24"
          class="hidden h-[18px] w-[18px]"
          fill="currentColor"
        >
          <path
            d="M16.3 12.6c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.7.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.5 0-2.8.8-3.5 2.1-1.5 2.6-.4 6.5 1.1 8.6.7 1 1.6 2.2 2.7 2.2 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.2-2.4 1.2-2.5-.1 0-2.3-.9-2.3-3.2ZM14.1 5.8c.6-.7 1-1.7.9-2.8-.9 0-2 .6-2.6 1.3-.6.7-1.1 1.7-.9 2.7 1 .1 2-.5 2.6-1.2Z"
          ></path>
        </svg>
      </span>

      <span data-dl-label>Download</span>
      <!--
        Deliberately NOT [data-gh-tag]: that hook means "the newest release" and
        is refreshed site-wide. This chip names the release the button actually
        hands you, which is an older one when the newest skipped this platform.
      -->
      <span data-dl-tag class="font-mono text-xs opacity-80">{catalog.latest}</span>
    </a>

    <!-- Companion action (e.g. "View on GitHub", "Read BUILD.md"). -->
    <slot />
  </div>

  <!--
    Small "other downloads" line. Built server-side with every asset; the client
    script rebuilds it with the visitor's own platform first and the rest after.
  -->
  <p
    data-dl-alt
    class="flex flex-wrap items-center gap-x-2 gap-y-1 px-0.5 font-mono text-[0.72rem] text-ink-faint"
  >
    {
      catalog.assets.map((asset) => (
        <>
          <a
            href={asset.url}
            title={assetTitle(asset)}
            class="underline decoration-line-strong underline-offset-[3px] transition-colors hover:text-ink-soft hover:decoration-ink-faint"
          >
            {isBehindLatest(asset, catalog)
              ? `${assetLabel(asset)} ${asset.tag}`
              : assetLabel(asset)}
          </a>
          <span aria-hidden="true">·</span>
        </>
      ))
    }
    <a
      href={RELEASES_URL}
      target="_blank"
      rel="noopener"
      class="underline decoration-line-strong underline-offset-[3px] transition-colors hover:text-ink-soft hover:decoration-ink-faint"
    >
      All releases ↗
    </a>
  </p>

  {
    flatpak && (
      <div
        data-flatpak
        role="group"
        aria-label="Install with Flatpak from Flathub"
        class="crop-frame mt-1 w-fit max-w-full overflow-hidden rounded-xl border border-line-strong bg-paper-2 shadow-[0_18px_40px_-30px_rgba(20,24,30,0.4)]"
      >
        <!-- Header: what this is, and where it comes from. -->
        <div class="flex items-center justify-between gap-4 border-b border-line bg-panel px-3.5 py-2">
          <span class="inline-flex items-center gap-2 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-ink-soft">
            <svg
              viewBox="0 0 24 24"
              class="h-3.5 w-3.5 text-accent"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 2.8 20 7.2v9.6L12 21.2 4 16.8V7.2L12 2.8Z" />
              <path d="M4 7.2 12 11.6l8-4.4M12 11.6v9.6" />
            </svg>
            Or via Flatpak
          </span>
          <a
            href={FLATHUB_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex shrink-0 items-center gap-1.5 font-mono text-[0.68rem] text-ink-faint transition-colors hover:text-ink"
          >
            {verified && (
              <svg
                viewBox="0 0 24 24"
                class="h-3 w-3 text-accent-2"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                aria-hidden="true"
              >
                <path d="M4 12.5 9.5 18 20 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {verified ? 'Verified on Flathub ↗' : 'Flathub ↗'}
          </a>
        </div>

        <!--
          One row per step. The step chip ticks once its command is copied and
          stays ticked, so the two-step install reads as progress. On narrow
          screens commands wrap at spaces under a hanging "$" instead of
          scrolling sideways, so nothing is ever hidden behind the copy button.
        -->
        <ol class="divide-y divide-line">
          {FLATPAK_STEPS.map((step, i) => (
            <li class="flex items-center gap-3 px-3.5 py-2.5 transition-colors hover:bg-panel/40">
              <span
                data-step
                class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-[0.3rem] border border-line-strong font-mono text-[0.62rem] text-ink-faint transition-colors data-[done]:border-accent-2/50 data-[done]:bg-accent-2/10"
                aria-hidden="true"
              >
                <span data-step-num>{i + 1}</span>
                <svg
                  data-step-done
                  viewBox="0 0 24 24"
                  class="hidden h-3 w-3 text-accent-2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.8"
                >
                  <path d="M4 12.5 9.5 18 20 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>

              <div class="flex min-w-0 flex-1 items-start gap-2 font-mono text-[0.8rem] leading-relaxed">
                <span class="select-none text-accent" aria-hidden="true">$</span>
                <code class="min-w-0 select-all break-words text-ink">{step.command}</code>
              </div>

              <button
                type="button"
                data-copy-cmd={step.command}
                data-copy-label={step.label}
                aria-label={`Copy the ${step.label.toLowerCase()} command`}
                class="inline-flex h-8 min-w-8 shrink-0 items-center justify-center gap-1.5 rounded-md border border-line-strong bg-paper-2 px-2 font-mono text-[0.68rem] text-ink-soft transition-colors hover:border-ink/30 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent data-[copied]:border-accent-2/50 data-[copied]:text-accent-2"
              >
                <svg
                  data-copy-icon
                  viewBox="0 0 24 24"
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="9" y="9" width="11" height="11" rx="2" />
                  <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke-linecap="round" />
                </svg>
                <svg
                  data-check-icon
                  viewBox="0 0 24 24"
                  class="hidden h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  aria-hidden="true"
                >
                  <path d="M4 12.5 9.5 18 20 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <!-- Fixed 6ch so "Copy" → "Copied" never nudges the layout. -->
                <span data-copy-text class="hidden w-[6ch] text-left sm:inline">Copy</span>
              </button>
            </li>
          ))}
        </ol>

        <p class="flex flex-wrap items-center gap-x-1.5 border-t border-line bg-panel/60 px-3.5 py-2 font-mono text-[0.68rem] text-ink-faint">
          New to Flatpak?
          <a
            href={FLATHUB_SETUP_URL}
            target="_blank"
            rel="noopener"
            class="underline decoration-line-strong underline-offset-[3px] transition-colors hover:text-ink-soft hover:decoration-ink-faint"
          >
            Set up Flathub first ↗
          </a>
        </p>

        <span data-copy-status class="sr-only" aria-live="polite" />
      </div>
    )
  }

  <!-- Build-time download catalog the client script starts from. -->
  <script
    type="application/json"
    data-dl-release
    is:inline
    set:html={catalogJson}
  />
</div>

<script>
  import { copyText } from '../scripts/clipboard';

  // One delegated listener serves every Flatpak panel on the page (the hero and
  // the download section each render one).
  const resets = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  const setCopied = (btn: HTMLElement, on: boolean) => {
    btn.querySelector('[data-copy-icon]')?.classList.toggle('hidden', on);
    btn.querySelector('[data-check-icon]')?.classList.toggle('hidden', !on);
    const text = btn.querySelector('[data-copy-text]');
    if (text) text.textContent = on ? 'Copied' : 'Copy';
    // Styled through data-[copied]: variants, which Tailwind always orders after
    // the button's base colours — toggling plain utility classes would lose.
    btn.toggleAttribute('data-copied', on);
  };

  document.addEventListener('click', async (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-copy-cmd]');
    if (!btn) return;
    if (!(await copyText(btn.dataset.copyCmd ?? ''))) return;

    // Button: a brief "Copied", then back to idle.
    setCopied(btn, true);
    clearTimeout(resets.get(btn));
    resets.set(btn, setTimeout(() => setCopied(btn, false), 1600));

    // Step chip: ticks and stays ticked.
    const row = btn.closest('li');
    row?.querySelector('[data-step-num]')?.classList.add('hidden');
    row?.querySelector('[data-step-done]')?.classList.remove('hidden');
    row?.querySelector('[data-step]')?.setAttribute('data-done', '');

    // Screen readers: clear first so copying the same line twice re-announces.
    const status = btn.closest('[data-flatpak]')?.querySelector('[data-copy-status]');
    if (status) {
      status.textContent = '';
      requestAnimationFrame(() => {
        status.textContent = `${btn.dataset.copyLabel} command copied`;
      });
    }
  });
</script>
