---
// FAQ — the questions people actually ask before switching CAD programs.
// Visible answers and FAQPage structured data come from the same data/faq.ts.
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import { FAQS, faqJsonLd } from '../data/faq';
import { absolute } from '../data/seo';

const title = 'Musa CAD FAQ — Price, License, DWG, Platforms and Privacy';
const description =
  'Is Musa CAD really free? Can it open DWG? Does it run on Linux and Mac, or do 3D? Can I use it commercially? Answers, plus what it does with your data.';
const crumbs = [{ name: 'FAQ', path: '/faq/' }];
const base = import.meta.env.BASE_URL;
// Answers carry root-relative links; prefix the base for project-pages builds.
const withBase = (html: string) => html.replace(/href="\/(?!\/)/g, `href="${base}`);
---

<Page {title} {description} {crumbs} type="FAQPage" pageData={{ mainEntity: faqJsonLd(absolute) }}>
  <PageHeader eyebrow="FAQ" title="Questions, answered" {crumbs}>
    <p>
      The things people ask me before they switch. If yours isn’t here,
      <a href={`${base}about/#contact`} class="font-medium text-ink underline decoration-accent/50 underline-offset-[3px] hover:text-accent-press">ask me directly</a>.
    </p>
  </PageHeader>

  <div class="mx-auto max-w-3xl px-5 pb-28 sm:px-8">
    <nav aria-label="Questions on this page" class="rounded-2xl border border-line bg-panel/60 p-5 sm:p-6">
      <ol class="grid gap-x-6 gap-y-2 text-[0.95rem] sm:grid-cols-2">
        {
          FAQS.map((f) => (
            <li>
              <a href={`#${f.id}`} class="text-ink-soft underline-offset-[3px] transition-colors hover:text-ink hover:underline">
                {f.question}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mt-12 divide-y divide-line">
      {
        FAQS.map((f) => (
          <section id={f.id} class="scroll-mt-[calc(var(--nav-h)+1.5rem)] py-8 first:pt-0" aria-labelledby={`${f.id}-q`}>
            <h2 id={`${f.id}-q`} class="font-display text-2xl font-semibold text-ink">
              {f.question}
            </h2>
            <div class="prose-doc mt-3">
              <p set:html={withBase(f.answer)} />
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Page>
